# mako bildirimleri — rofi / seçicilerle aynı dil: koyu yarı saydam zemin, ince accent çerçeve, yumuşak köşe
# (ilk border-color satırı = accent; settings.sh "Border colour" günceller. mako satır sonu yorumu desteklemez.)
font=Noto Sans 10
background-color=#000000d1
text-color=#cdd6f4
border-color=#b4befe
border-size=1
border-radius=12
padding=10,14
margin=6
outer-margin=12
width=380
height=160
max-visible=5
default-timeout=5000
anchor=top-right
layer=overlay
icons=1
max-icon-size=40
icon-location=left
icon-path=/usr/share/icons/breeze-dark:/usr/share/icons/breeze
markup=1
# uygulama adı küçük/soluk, başlık kalın, gövde normal
format=<span size="small" alpha="55%%">%a</span>\n<b>%s</b>\n%b
progress-color=over #b4befe40
# sorun ayıklama: makoctl history
max-history=50

[urgency=low]
text-color=#a6adc8
default-timeout=3000

[urgency=high]
border-color=#f38ba8
default-timeout=0

# Ses / mikrofon / parlaklık OSD'si (volume.sh, brightness.sh): tek satır, uygulama adı yok
[app-name=Volume]
format=<b>%s</b>  %b
default-timeout=1200

[app-name=Brightness]
format=<b>%s</b>  %b
default-timeout=1200

# makoctl mode -t dnd → bildirimler gizlenir (geçmişte kalır)
[mode=dnd]
invisible=1
