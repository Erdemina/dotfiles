{
    // -------------------------------------------------------------------------
    // Global configuration
    // -------------------------------------------------------------------------

    "layer": "top",

    "position": "top",

    //"height": 20,

    "margin-left": 10,
    "margin-bottom": 0,
    "margin-right": 10,

    "spacing": 5, // Gaps between modules (4px)

    "modules-left": [
        "hyprland/workspaces",
        //"idle_inhibitor",
        //"mpd",
        "custom/media"
    ],
    "modules-center": [
        "clock#date",
        "custom/weather"
    ],
    "modules-right": [
        "backlight",
        "temperature",
        "memory",
        "cpu",
	"network",
        "idle_inhibitor",
        "custom/powerprofile",
        "battery",
        "pulseaudio",
        //"custom/screenshot_t",
        "tray",
        "custom/power"
    ],


    // -------------------------------------------------------------------------
    // Modules
    // -------------------------------------------------------------------------

    "custom/sp1": {
        "format": " | ",
        "tooltip": false
    },
    "custom/sp2": {
        "format": " |",
        "tooltip": false
    },

    "custom/screenshot_t":{
        "format":"",
        "on-click": "~/.config/hypr/scripts/screenshot_region.sh"
    },

    "temperature": {
        "tooltip-format": "CPU temperature: {temperatureC}°C\nClick: xsensors",
        // "thermal-zone": 1,
        "interval": 4,
        //"hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
        "critical-threshold": 80,
        // "format-critical": " {temperatureC}°C",
        "format-critical": "  {temperatureC}°C",
        "format": "{icon}  {temperatureC}°C",
        "format-icons": ["", "", ""],
        "on-click": "xsensors"
    },

    "memory": {
        "tooltip-format": "Memory: {used:0.1f} / {total:0.1f} GB (%{percentage})\nSwap: {swapUsed:0.1f} / {swapTotal:0.1f} GB\nClick: btop",
        "interval": 10,
        "format": "☰ {used:0.2f} / {total:0.0f} GB",
        "on-click": "ghostty -e btop"
    },

    "battery": {
        "tooltip-format": "Battery: %{capacity} — {timeTo}\nPower draw: {power}W\nClick: power profile (performance / balanced / power saver)",
        "on-click": "~/.config/hypr/scripts/powerprofile.sh",
        "interval": 2,
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "network": {
        "format-wifi": "  {bandwidthDownBytes}   {bandwidthUpBytes}",
        "format-ethernet": "  {bandwidthDownBytes}   {bandwidthUpBytes}",
        "interval": 1,
        "format-linked": "{ifname} (No IP) ",
        "format": "",
        "format-disconnected": "󰤭  offline",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "wl-copy $(ip address show up scope global | grep inet | head -n1 | cut -d/ -f 1 | tr -d [:space:] | cut -c5-)",
        "tooltip-format": "Network: {ifname}\nIP: {ipaddr}/{cidr}\n {bandwidthUpBits}  {bandwidthDownBits}\nClick: copy IP",
        "tooltip-format-wifi": "Wi-Fi: {essid} ({frequency} MHz)\nSignal: {signaldBm} dBm (%{signalStrength})\nIP: {ipaddr}/{cidr}\n {bandwidthUpBits}  {bandwidthDownBits}\nClick: copy IP",
        "tooltip-format-disconnected": "No network connection"
    },

    "backlight": {
        "tooltip-format": "Screen brightness: %{percent}\nScroll: ±5%",
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-alt": "{percent}% {icon}",
        "format-alt-click": "click-right",
        //"format-icons": ["", ""],
        //"format-icons": ["", ""],
	"format-icons": [""],
        "on-scroll-down": "brightnessctl s 5%-",
        "on-scroll-up": "brightnessctl s +5%"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰾪"
        },
        "tooltip": true,
        "tooltip-format-activated": "Caffeine ON — screen will not lock or sleep\nClick: turn off",
        "tooltip-format-deactivated": "Caffeine OFF — normal idle/lock\nClick: keep awake"
    },
    "custom/weather": {
        "tooltip-format": "Weather (Istanbul, wttr.in)\nClick: open forecast in browser",
        "format": "{}",
        "on-click": "xdg-open https://wttr.in/Istanbul",
        "interval": 3600,
        "exec": "curl -s 'https://wttr.in/Istanbul?format=1'",
        //"return-type": "json",
        //"exec": "~/.config/waybar/modules/weather.sh",
        "exec-if": "ping -c1 -W2 wttr.in"
    },
    "custom/media": {
        "tooltip-format": "Now playing\nClick: play/pause · Scroll: previous/next",
        "format": "{icon} {text}",
        "return-type": "json",
        "max-length": 40,
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "format-icons": {
            "spotify": "",
            "default": "🎜"
        },
        "escape": true
    },

    "custom/powerprofile": {
        "format": "{}",
        "exec": "~/.config/hypr/scripts/powerprofile.sh status",
        "interval": 30,
        "signal": 8,
        "tooltip": true,
        "tooltip-format": "Power profile\nClick: change",
        "on-click": "~/.config/hypr/scripts/powerprofile.sh"
    },
    "custom/power": {
        "tooltip": true,
        "tooltip-format": "Power menu (lock / log out / suspend / reboot / shut down)",
        "format": "󰐥",
        "on-click": "~/.config/hypr/scripts/powermenu.sh"
    },

    "clock#date": {
        "format": "{:%H:%M  %e %b}", // Icon: calendar-alt
        //"format": "{:%I:%M %p  %A %b %d}",
        "tooltip-format": "<big>{:%d %B %Y, %A}</big>\n<tt><small>{calendar}</small></tt>",
        "today-format": "<b>{}</b>"
    },

    "cpu": {
        "tooltip": true,
        "tooltip-format": "CPU usage: %{usage} @ {max_frequency} GHz\nLoad: {load}",
        "interval": 1,
        //"format": " {}%", // Icon: microchip
        "format": "  {max_frequency}GHz <span color=\"darkgray\">| {usage}%</span>",
        "max-length": 15,
        "min-length": 15
    },

    "mpd": {
        "max-length": 25,
        "format": "<span foreground='#bb9af7'></span> {title}",
        "format-paused": " {title}",
        "format-stopped": "<span foreground='#bb9af7'></span>",
        "format-disconnected": "",
        "on-click": "mpc --quiet toggle",
        "on-click-right": "mpc update; mpc ls | mpc add",
        "on-click-middle": "alacritty -e ncmpcpp",
        "on-scroll-up": "mpc --quiet prev",
        "on-scroll-down": "mpc --quiet next",
        "smooth-scrolling-threshold": 5,
        "tooltip-format": "{title} - {artist} ({elapsedTime:%M:%S}/{totalTime:%H:%M:%S})"
    },


    /*"custom/keyboard": {
        "format": " {}",
        "interval": 1,
        "exec": "$HOME/.config/waybar/get_kbdlayout.sh"
    },*/

    "hyprland/workspaces": {
        "on-click": "activate",
        "tooltip": false,
        "persistent-workspaces": { "*": 5 },
        "format": "{id}",
        "all-outputs": true,
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

    "pulseaudio": {
        "scroll-step": 3, // %, can be a float
        "format": "{icon} {volume}% {format_source}",
        "format-bluetooth": "{volume}% {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
	"ignored-sinks": ["Easy Effects Sink"],
	"max-volume": 150,
        //"format-source": "{volume}% ",
        //"format-source-muted": "",
        "format-source": "",
        "format-source-muted": "",
        "format-icons": {
            //"headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "tooltip-format": "Volume: %{volume} ({desc})\nClick: pavucontrol · Right click: mute mic · Scroll: ±3%",
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
    },

    "tray": {
        "tooltip": true,
        "icon-size": 15,
        "spacing": 5
    }
}
